// ============================================================
// Agency Management Platform — Prisma Schema
// PostgreSQL · Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

// v3: the permission tier. A role answers "what may this person do",
// never "what is their job" — that's Designation (docs/V3_CONTEXT.md §2).
enum UserRole {
  OWNER // Organization owner — super admin, cannot be removed
  ADMIN // Full system access within the organization
  MANAGER // Clients, projects, money — everything but user management
  SMM // Plans their own projects, reviews juniors' work, sees NO money
  TEAM // Junior: works assigned tasks, self-reminders only
  MEMBER // Deprecated v2 tier — migrated to TEAM, kept so old rows still read
}

enum ClientStatus {
  PROSPECT // Not yet a paying client
  ACTIVE // Current client
  INACTIVE // No ongoing work
  ARCHIVED // Soft-deleted
}

// v2: how much attention a client warrants (drives reminder targeting)
enum ClientImportance {
  NORMAL
  IMPORTANT
  VIP
}

// v2: job label for team members — routing & report targeting only,
// NOT a permission level (that stays UserRole).
//
// v3 DEPRECATED: superseded by the Designation *model*, which agencies
// create themselves in Settings. Kept (unused) so existing rows still read.
enum Designation {
  SMM
  DESIGNER
  EDITOR
  HEAD_OF_DESIGN
  PHOTOGRAPHER
  SME
  POC
  OTHER
}

enum ProjectType {
  ONE_TIME // Fixed scope project
  RETAINER // Ongoing recurring engagement
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

// v3: what KIND of work a task represents (docs/V3_CONTEXT.md §3). Auto-tasks
// the system creates are PLANNING and POST; a junior's brief is CONTENT_WORK.
enum TaskKind {
  PLANNING // "New client onboarded — plan <project>", for the SMM
  CONTENT_WORK // a junior's brief, linked to a content item
  POST // "Post <topic> for <client>", created when work is approved
  GENERAL // an ordinary task, the v1/v2 default
  PERSONAL // a self-reminder
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// v2: preferred-assignee routing through Head of Design
enum AssignmentStatus {
  NONE
  PENDING_HEAD_APPROVAL
  APPROVED
  REASSIGNED
}

// v2: how a finished task was delivered to the client/manager
enum DeliveryMethod {
  FILE_UPLOAD
  LINK
  WHATSAPP
  SLACK
  OTHER
}

// v2: change-request lifecycle on a task
enum ChangeRequestStatus {
  OPEN
  RESOLVED
}

// v2: content-item pipeline (every transition logged + timestamped)
enum ContentStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  TEAM_APPROVED
  CLIENT_APPROVED
  SCHEDULED
  POSTED
  MISSED
  // ── v3 (docs/V3_CONTEXT.md §3) ──
  SUBMITTED // the junior sent it in with proof; waiting on the SMM
  APPROVED // the SMM approved it; the posting task now exists
  CHANGES_REQUESTED // sent back for another round
  CARRIED_FORWARD // not posted this cycle; cloned into the next one
}

// v3: whether an item is inside the deal, an extra to bill, or a freebie.
// The SMM sets this at cycle close and NEVER sees an amount.
enum BillingIntent {
  INCLUDED
  EXTRA_BILLABLE
  COMPLIMENTARY
}

// v3: when an item is carried into the next cycle, does it eat that cycle's
// quota or sit on top of it?
enum CarryMode {
  INSIDE_QUOTA
  ABOVE_QUOTA
}

enum PricingType {
  FIXED // Lump-sum price for the whole line item
  RETAINER // Monthly recurring fee
  PER_ITEM // quantity × unit price
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum FileStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUIRED
}

enum FileCommentStatus {
  OPEN
  RESOLVED
}

enum ExpenseCategory {
  SOFTWARE_TOOLS
  FREELANCER_PAYMENT
  VENDOR_PAYMENT
  STOCK_ASSETS
  PRINTING
  TRAVEL
  ADVERTISING
  OFFICE
  EQUIPMENT
  COMMISSIONS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ContractType {
  NDA
  SERVICE_AGREEMENT
  EMPLOYMENT
  FREELANCE
  PARTNERSHIP
  OTHER
}

enum ContractStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  FULLY_SIGNED
  EXPIRED
  TERMINATED
}

enum ContractPartyType {
  CLIENT
  // v3: the Stakeholder model is retired — an external party is now just a
  // name/email captured on the ContractParty row itself.
  STAKEHOLDER
  USER
}

enum ProjectRole {
  EDITOR // Can edit tasks, files, chat — full project access
  VIEWER // Can view everything but only edit their assigned tasks
  // v3: the two roles that matter commercially (docs/V3_CONTEXT.md §3).
  SMM // Plans this project's cycles and reviews the work
  CONTRIBUTOR // Works on it, doesn't plan it
}

// v3: how long one billing cycle runs. Only MONTH today; the enum exists so
// WEEK/QUARTER can be added without a data migration.
enum CycleUnit {
  WEEK
  MONTH
  QUARTER
}

enum CycleStatus {
  OPEN
  CLOSED
}

// ============================================================
// USERS — Agency team members
// ============================================================

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  avatarUrl      String?
  role           UserRole  @default(TEAM)
  // v2 enum, deprecated — read only for rows created before v3
  designation    Designation?
  // v3: the job label, created dynamically per organization
  designationId  String?
  isActive       Boolean   @default(true)
  // Login password. Nullable so users created before passwords existed (and
  // freshly-invited teammates) are prompted to set one on first sign-in.
  passwordHash   String?
  passwordSetAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobTitle     DesignationRole? @relation(fields: [designationId], references: [id], onDelete: SetNull)

  // Relations
  managedTasks       Task[]          @relation("TaskManager")
  taskAssignments    TaskAssignee[]
  createdProjects    Project[]       @relation("ProjectCreator")
  uploadedFiles      File[]          @relation("UploadedFiles")
  comments           Comment[]
  timeEntries        TimeEntry[]
  fileComments       FileComment[]
  expenses           Expense[]
  contractParties    ContractParty[]
  channelMemberships ChannelMember[]
  sentMessages       ChatMessage[]   @relation("SentMessages")
  projectMemberships ProjectMember[]
  statusChanges      StatusHistory[] @relation("StatusChanges")
  notifications      Notification[]
  preferredForTasks  Task[]          @relation("TaskPreferredAssignee")
  deliveries         TaskDelivery[]  @relation("Deliveries")
  changeRequests     ChangeRequest[] @relation("ChangeRequests")
  createdContentItems ContentItem[]  @relation("CreatedContentItems")
  personalItems        PersonalItem[] @relation("PersonalItems")
  createdPersonalItems PersonalItem[] @relation("CreatedPersonalItems")
  taskLists            TaskList[]     @relation("TaskLists")
  createdEvents        CalendarEvent[] @relation("CreatedEvents")
  assignedFollowUps    FollowUp[]      @relation("AssignedFollowUps")
  createdFollowUps     FollowUp[]      @relation("CreatedFollowUps")
  createdReviewBatches ReviewBatch[]   @relation("CreatedReviewBatches")
  projectMembersAdded  ProjectMember[] @relation("ProjectMembersAdded")
  closedCycles         ProjectCycle[]  @relation("CyclesClosed")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ============================================================
// TRIAL REQUESTS — public "request a workspace / free trial" leads
// ============================================================

enum TrialRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

model TrialRequest {
  id          String             @id @default(cuid())
  agencyName  String
  contactName String
  email       String
  phone       String?
  location    String? // where they're based
  website     String?
  teamSize    String? // free-text range, e.g. "1-5"
  services    String? // what they do
  message     String?
  status      TrialRequestStatus @default(NEW)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status])
  @@map("trial_requests")
}

// ============================================================
// CLIENTS — Companies or individuals the agency works for
// ============================================================

model Client {
  id               String       @id @default(cuid())
  organizationId   String
  name             String
  companyName      String?
  email            String?
  phone            String?
  website          String?
  industry         String?
  address          String?
  logoUrl          String?
  links            Json? // [{ id, label, url, type }]
  brandColors      Json? // [{ id, hex, name, tag }]
  brandAssets      Json? // [{ id, name, type, variant, url, format, notes }]
  taxRegistrations Json? // [{ id, type, number, country }]
  notes            String?
  status           ClientStatus @default(ACTIVE)
  // v2: overrides the organization currency for everything client-scoped
  currency         String?
  // v2: attention level — drives reminder targeting later
  importance       ClientImportance @default(NORMAL)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts        ClientContact[]
  projects        Project[]
  invoices        Invoice[]
  files           File[]
  folders         Folder[]
  contracts       Contract[]
  contractParties ContractParty[]
  channels        Channel[]
  expenses        Expense[]
  receipts        Receipt[]
  tasks           Task[]          @relation("ClientTasks")
  contentItems    ContentItem[]   @relation("ClientContentItems")
  events          CalendarEvent[] @relation("ClientEvents")
  packages        ClientPackage[] @relation("ClientPackages")
  followUps       FollowUp[]      @relation("ClientFollowUps")
  reviewBatches   ReviewBatch[]   @relation("ClientReviewBatches")

  @@index([organizationId])
  @@map("clients")
}

// v3: the job label an agency defines for itself (Editor, Photographer,
// Videographer…). Drives assignment pickers, filtering and reporting —
// NEVER permissions, which are UserRole + lib/permissions.ts capabilities.
//
// Named DesignationRole because the deprecated v2 `Designation` enum still
// occupies that name in the generated client.
model DesignationRole {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  slug              String
  isActive          Boolean  @default(true)
  /// Can work be assigned to people with this job? (An SME or POC usually can't.)
  canBeAssignedWork Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("designations")
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_contacts")
}

// ============================================================
// PROJECTS — Work engagements per client
// ============================================================

model Project {
  id                 String        @id @default(cuid())
  organizationId     String
  clientId           String
  createdById        String?
  name               String
  description        String?
  type               ProjectType   @default(ONE_TIME)
  serviceType        String?
  recurringFrequency String?
  status             ProjectStatus @default(DRAFT)
  startDate          DateTime?
  endDate            DateTime?
  budget             Decimal?      @db.Decimal(12, 2)
  currency           String        @default("USD")

  // ── v3: the project IS the commercial unit (docs/V3_CONTEXT.md §3) ──
  /// What the client pays per cycle. ONE_TIME projects have a single cycle,
  /// so this is the whole project's price.
  cycleAmount    Decimal?  @db.Decimal(12, 2)
  cycleUnit      CycleUnit @default(MONTH)
  cycleStartDate DateTime?
  /// null = open-ended (a retainer with no agreed end)
  cycleEndDate   DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client          @relation(fields: [clientId], references: [id])
  createdBy    User?           @relation("ProjectCreator", fields: [createdById], references: [id])
  deliverables ProjectDeliverable[]
  cycles       ProjectCycle[]
  tasks        Task[]
  files        File[]
  folders      Folder[]
  invoices     Invoice[]
  expenses     Expense[]
  contracts    Contract[]
  channels     Channel[]
  members      ProjectMember[]
  contentItems ContentItem[]   @relation("ProjectContentItems")

  @@index([status, clientId])
  @@index([clientId])
  @@index([organizationId])
  @@map("projects")
}

// ── Project membership — controls who can access a project ──

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  addedAt   DateTime    @default(now())
  addedById String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy User?   @relation("ProjectMembersAdded", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([projectId, userId])
  @@map("project_members")
}

// ── v3: what the project owes the client, and when it's owed ──

/// One line of the deal: "15 Reels", "5 Posts", "1 Photo Shoot".
/// RETAINER → per cycle. ONE_TIME → for the whole project.
model ProjectDeliverable {
  id             String   @id @default(cuid())
  projectId      String
  creativeTypeId String
  qtyPerCycle    Int
  notes          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creativeType CreativeType @relation(fields: [creativeTypeId], references: [id], onDelete: Cascade)

  @@unique([projectId, creativeTypeId])
  @@index([projectId])
  @@map("project_deliverables")
}

/// One billing period of a project — "Aug 2026". Content is planned into a
/// cycle, the cycle is closed deliberately (Phase 6), and the close is what
/// produces the billable items an invoice is built from (Phase 7).
model ProjectCycle {
  id         String      @id @default(cuid())
  projectId  String
  label      String // "Aug 2026"
  startDate  DateTime
  endDate    DateTime
  status     CycleStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  /// Set once the cycle has been billed
  invoiceId  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closedBy     User?         @relation("CyclesClosed", fields: [closedById], references: [id], onDelete: SetNull)
  contentItems ContentItem[]

  @@unique([projectId, startDate])
  @@index([projectId, status])
  @@map("project_cycles")
}

// ============================================================
// TASKS — Hierarchical work items within a project
// ============================================================

model Task {
  id                   String     @id @default(cuid())
  organizationId       String
  // v2: optional — tasks may exist without a project ("general tasks")
  projectId            String?
  parentId             String?
  managerId            String?
  title                String
  description          String?
  status               TaskStatus @default(TODO)
  // v3: what kind of work this is. GENERAL keeps every pre-v3 task correct.
  kind                 TaskKind   @default(GENERAL)
  priority             Priority   @default(MEDIUM)
  dueDate              DateTime?
  order                Int        @default(0)
  // ── v2 fields ──────────────────────────────────────────────
  topic                String?
  content              String? // brief / caption text
  referenceUrl         String?
  referenceFileId      String?
  extraNote            String?
  // v2: direct client link (independent of project)
  clientId             String?
  // v2: link back to the content-calendar entry
  contentItemId        String?
  contentItem          ContentItem? @relation("ContentItemTasks", fields: [contentItemId], references: [id])
  preferredAssigneeId  String?
  assignmentStatus     AssignmentStatus @default(NONE)
  sortOrder            Int        @default(0) // personal-queue rank
  isAdHoc              Boolean    @default(false)
  progress             Int        @default(0) // Cached 0-100, recomputed on subtask change
  estimatedHours       Float? // Time estimate in hours
  loggedHours          Float      @default(0) // Total logged hours (sum of TimeEntry)
  isClientVisible      Boolean    @default(false) // Show this task in client portal
  showSubtasksToClient Boolean    @default(false) // Also show subtasks to client
  deletedAt            DateTime? // Soft delete
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Self-referencing hierarchy
  parent   Task?  @relation("TaskHierarchy", fields: [parentId], references: [id])
  children Task[] @relation("TaskHierarchy")

  // Relations
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       Client?          @relation("ClientTasks", fields: [clientId], references: [id])
  referenceFile     File?       @relation("TaskReferenceFile", fields: [referenceFileId], references: [id])
  preferredAssignee User?       @relation("TaskPreferredAssignee", fields: [preferredAssigneeId], references: [id])
  deliveries    TaskDelivery[]
  changeRequests ChangeRequest[]
  manager      User?            @relation("TaskManager", fields: [managerId], references: [id])
  assignees    TaskAssignee[]
  files        File[]
  comments     Comment[]
  timeEntries  TimeEntry[]
  // Dependencies: tasks this task depends on (must be done before this task)
  dependsOn    TaskDependency[] @relation("dependant")
  // Dependencies: tasks that depend on this task (this task blocks them)
  blockedBy    TaskDependency[] @relation("dependency")
  fileComments FileComment[]
  chatMessages ChatMessage[]

  @@index([status, projectId])
  @@index([projectId, deletedAt])
  @@index([dueDate])
  @@index([organizationId])
  @@index([clientId])
  @@index([contentItemId])
  @@index([organizationId, assignmentStatus])
  @@map("tasks")
}

// ============================================================
// V2 — CONTENT CALENDAR (one per client; the spine)
// ============================================================

// Org catalog of creative types: Post, Reel, Story, Photo Shoot, …
model CreativeType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  icon           String? // lucide icon name or emoji
  color          String? // hex chip color
  countsAsShoot  Boolean @default(false)
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  quotas       PackageQuota[]
  deliverables ProjectDeliverable[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("creative_types")
}

// One planned deliverable on a client's content calendar
model ContentItem {
  id                    String        @id @default(cuid())
  organizationId        String
  clientId              String
  projectId             String?
  date                  DateTime
  creativeTypeId        String
  topic                 String
  description           String?
  referenceUrl          String?
  referenceFileId       String?
  status                ContentStatus @default(PLANNED)
  isExtra               Boolean       @default(false)
  isAdHoc               Boolean       @default(false)
  carriedFromId         String?
  countAgainstPrevMonth Boolean       @default(false)

  // ── v3: which cycle this belongs to, and how it bills ──
  /// The billing period this item is planned into. Nullable so legacy items
  /// planned against a client rather than a project still read.
  cycleId       String?
  billingIntent BillingIntent @default(INCLUDED)
  /// Only set on an item that was carried in from a previous cycle.
  carryMode     CarryMode?
  submittedAt   DateTime?
  approvedAt    DateTime?

  postedAt              DateTime?
  teamApprovedAt        DateTime?
  clientApprovedAt      DateTime?
  invoicedInId          String? // stamped by Phase 7 invoicing
  reviewToken           String?       @unique // Phase 10 share link
  reviewTokenExpiresAt  DateTime?
  createdById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client        @relation("ClientContentItems", fields: [clientId], references: [id], onDelete: Cascade)
  project       Project?      @relation("ProjectContentItems", fields: [projectId], references: [id], onDelete: SetNull)
  creativeType  CreativeType  @relation(fields: [creativeTypeId], references: [id])
  cycle         ProjectCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  referenceFile File?         @relation("ContentReferenceFiles", fields: [referenceFileId], references: [id])
  carriedFrom   ContentItem?  @relation("CarryForward", fields: [carriedFromId], references: [id])
  carriedTo     ContentItem[] @relation("CarryForward")
  createdBy     User?         @relation("CreatedContentItems", fields: [createdById], references: [id])
  tasks         Task[]        @relation("ContentItemTasks")
  billedLines   InvoiceLineItem[] @relation("BilledContentItems")

  @@index([cycleId, status])
  @@index([organizationId, clientId, date])
  @@index([clientId, status])
  @@index([organizationId, date])
  @@map("content_items")
}

// v2: delivery proof recorded when a task is completed
model TaskDelivery {
  id            String         @id @default(cuid())
  taskId        String
  method        DeliveryMethod
  fileId        String?
  url           String?
  note          String?
  deliveredById String?
  deliveredAt   DateTime       @default(now())

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file        File? @relation("DeliveryFiles", fields: [fileId], references: [id])
  deliveredBy User? @relation("Deliveries", fields: [deliveredById], references: [id])

  @@index([taskId])
  @@map("task_deliveries")
}

// v2: "assign changes" — what to change, flips the task back to work
model ChangeRequest {
  id            String              @id @default(cuid())
  taskId        String
  requestedById String?
  note          String
  status        ChangeRequestStatus @default(OPEN)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User? @relation("ChangeRequests", fields: [requestedById], references: [id])

  @@index([taskId, status])
  @@map("change_requests")
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_assignees")
}

// Task dependency: taskId depends on dependsOnId (cannot start until dependsOnId is DONE)
model TaskDependency {
  taskId      String
  dependsOnId String

  task      Task @relation("dependant", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@map("task_dependencies")
}

// Time tracking entries per task per user
model TimeEntry {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  hours     Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@map("time_entries")
}

// ============================================================
// TASK TEMPLATES — Reusable task structures
// ============================================================

model TaskTemplate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  projectType    ProjectType?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        TaskTemplateItem[]

  @@index([organizationId])
  @@map("task_templates")
}

model TaskTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  order       Int      @default(0)
  offsetDays  Int? // Days from project start date for auto due-date
  parentOrder Int? // order of the parent item (null = top-level)

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("task_template_items")
}

// ============================================================
// INVOICES
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  clientId       String
  invoiceNumber  String // unique per organization
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  currency       String        @default("USD")
  discountPct    Decimal?      @db.Decimal(5, 2)
  taxPct         Decimal?      @db.Decimal(5, 2)
  notes          String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?          @relation(fields: [projectId], references: [id])
  client       Client            @relation(fields: [clientId], references: [id])
  lineItems    InvoiceLineItem[]
  receipts     Receipt[]

  @@unique([organizationId, invoiceNumber])
  @@index([status, clientId])
  @@index([dueDate])
  @@index([organizationId])
  @@map("invoices")
}

// v2: what a line bills — the monthly package, an extra deliverable, or custom
enum LineItemKind {
  PACKAGE
  EXTRA
  CUSTOM
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  unit        String?
  order       Int     @default(0)
  // ── v2 fields ──
  kind          LineItemKind @default(CUSTOM)
  isFree        Boolean      @default(false) // complimentary — excluded from totals
  contentItemId String?

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation("BilledContentItems", fields: [contentItemId], references: [id])

  @@map("invoice_line_items")
}

// ============================================================
// EXPENSES — Outgoing costs linked to projects / vendors
// ============================================================

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  description    String?
  category       ExpenseCategory @default(OTHER)
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("USD")
  date           DateTime        @default(now())
  status         ExpenseStatus   @default(PENDING)
  projectId      String?
  clientId       String?
  userId         String?
  isReimbursable Boolean         @default(false)
  receiptUrl     String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([organizationId])
  @@map("expenses")
}

// ============================================================
// RECEIPTS — Records of payments received from clients
// ============================================================

enum ReceiptMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  UPI
  OTHER
}

model Receipt {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  invoiceId      String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  receivedAt     DateTime      @default(now())
  method         ReceiptMethod @default(BANK_TRANSFER)
  reference      String? // e.g. transaction id, cheque number
  receiptNumber  String? // optional internal numbering
  notes          String?
  attachmentUrl  String? // optional uploaded receipt file
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([invoiceId])
  @@index([receivedAt])
  @@index([organizationId])
  @@map("receipts")
}

// ============================================================
// CONTRACTS & NDAs
// ============================================================

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  type           ContractType   @default(NDA)
  status         ContractStatus @default(DRAFT)
  projectId      String?
  clientId       String?
  fileId         String? // attached contract PDF (link to File)
  startDate      DateTime?
  endDate        DateTime?
  value          Decimal?       @db.Decimal(12, 2)
  currency       String         @default("USD")
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parties      ContractParty[]

  @@index([organizationId])
  @@map("contracts")
}

model ContractParty {
  id            String            @id @default(cuid())
  contractId    String
  partyType     ContractPartyType
  clientId      String?
  userId        String?
  name          String
  email         String?
  signedAt      DateTime?
  signatureNote String?
  createdAt     DateTime          @default(now())

  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contract_parties")
}

// ============================================================
// FILES & FOLDERS
// ============================================================

enum FolderScope {
  PROJECT // Files belonging to a specific project
  CLIENT // Client-wide files (brand assets, guidelines — shared across projects)
  COMMON // Agency-wide files (templates, internal assets)
}

model Folder {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  parentId       String? // Self-referencing for nested folders
  scope          FolderScope @default(PROJECT)
  projectId      String? // Set when scope = PROJECT
  clientId       String? // Set when scope = CLIENT or PROJECT (inherited from project)
  description    String?
  color          String? // Optional folder color for UI
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]     @relation("FolderHierarchy")
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  files        File[]

  @@index([organizationId])
  @@map("folders")
}

model File {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  mimeType       String
  mimeCategory   String     @default("other")
  size           Int
  s3Key          String
  s3Bucket       String     @default("local")
  url            String?
  thumbnailUrl   String?
  description    String?
  status         FileStatus @default(DRAFT)
  isShared       Boolean    @default(false)
  folderId       String?
  clientId       String?
  projectId      String?
  taskId         String?
  uploadedById   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder             Folder?             @relation(fields: [folderId], references: [id], onDelete: SetNull)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy         User?               @relation("UploadedFiles", fields: [uploadedById], references: [id])
  versions           FileVersion[]
  fileTags           FileTag[]
  comments           FileComment[]
  messageAttachments MessageAttachment[]
  referencedByTasks  Task[]              @relation("TaskReferenceFile")
  deliveries         TaskDelivery[]      @relation("DeliveryFiles")
  contentReferences  ContentItem[]       @relation("ContentReferenceFiles")

  @@index([projectId])
  @@index([clientId])
  @@index([folderId])
  @@index([status])
  @@index([organizationId])
  @@map("files")
}

model FileVersion {
  id           String   @id @default(cuid())
  fileId       String
  version      Int
  s3Key        String
  url          String?
  thumbnailUrl String?
  size         Int
  notes        String?
  uploadedById String?
  createdAt    DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@map("file_versions")
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String?

  fileTags FileTag[]

  @@map("tags")
}

model FileTag {
  fileId String
  tagId  String

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([fileId, tagId])
  @@map("file_tags")
}

model FileComment {
  id         String            @id @default(cuid())
  fileId     String
  versionId  String?
  authorId   String?
  authorName String            @default("Anonymous")
  body       String
  posX       Float?
  posY       Float?
  timestamp  Float?
  page       Int?
  status     FileCommentStatus @default(OPEN)
  parentId   String?
  taskId     String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  file    File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author  User?         @relation(fields: [authorId], references: [id])
  parent  FileComment?  @relation("FileCommentThread", fields: [parentId], references: [id])
  replies FileComment[] @relation("FileCommentThread")
  task    Task?         @relation(fields: [taskId], references: [id])

  @@map("file_comments")
}

// ============================================================
// COMMENTS — Threaded comments on tasks
// ============================================================

model Comment {
  id         String      @id @default(cuid())
  taskId     String
  authorId   String? // Nullable until auth is wired up
  authorName String      @default("Anonymous") // Display name fallback
  body       String
  type       CommentType @default(COMMENT) // COMMENT = discussion, UPDATE = activity log entry
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id])

  @@map("comments")
}

enum CommentType {
  COMMENT
  UPDATE
}

// ============================================================
// MESSAGING — Slack-like channels + messages
// ============================================================

model Channel {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           ChannelType @default(GENERAL)
  projectId      String? // set for PROJECT_INTERNAL / PROJECT_CLIENT
  clientId       String? // set for CLIENT channels
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members      ChannelMember[]
  messages     ChatMessage[]

  @@index([organizationId])
  @@map("channels")
}

enum ChannelType {
  GENERAL // Company-wide channels (e.g. #general, #announcements)
  PROJECT_INTERNAL // Team-only channel per project
  PROJECT_CLIENT // Team + client per project
  CLIENT // Per-client general channel
  DIRECT // DM between two users (future)
}

model ChannelMember {
  channelId  String
  userId     String
  role       ChannelMemberRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt   DateTime          @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_members")
}

enum ChannelMemberRole {
  ADMIN
  MEMBER
}

model ChatMessage {
  id         String    @id @default(cuid())
  channelId  String
  authorId   String?
  authorName String    @default("Team")
  body       String
  taskId     String? // optional linked task
  parentId   String? // for thread replies (future)
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel     Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User?               @relation("SentMessages", fields: [authorId], references: [id])
  task        Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  parent      ChatMessage?        @relation("MessageThread", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     ChatMessage[]       @relation("MessageThread")
  attachments MessageAttachment[]

  @@map("chat_messages")
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  fileId    String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@map("message_attachments")
}

// Billing plan for a tenant. TRIAL is time-limited (see trialEndsAt);
// FULL is a paid/comped workspace with no trial expiry.
enum PlanTier {
  TRIAL
  FULL
}

// ─── Organization (the agency itself — multi-tenant root) ──────────────────
// Every user, client, project, invoice, etc. belongs to exactly one
// Organization. Data is fully isolated across organizations.
model Organization {
  id               String  @id @default(cuid())
  name             String  @default("My Agency")
  slug             String? @unique // optional URL-friendly identifier
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  country          String?
  logoUrl          String?
  currency         String  @default("USD")
  timezone         String  @default("UTC")
  dateFormat       String  @default("MMM D, YYYY")
  taxRegistrations Json? // [{ id, type, number, country }]

  // Letterhead / PDF template
  letterheadLogoUrl  String?
  letterheadHeader   String?
  letterheadFooter   String?
  letterheadAddress  String?
  letterheadPhone    String?
  letterheadEmail    String?
  letterheadWebsite  String?
  letterheadColor    String  @default("#6366f1")
  letterheadTemplate String  @default("CLASSIC")
  letterheadConfig   String?

  // Onboarding: new tenants are created by the platform admin with this
  // false; the org OWNER completes the onboarding form on first login,
  // which flips it true and unlocks the dashboard.
  onboardingCompleted Boolean   @default(false)
  onboardedAt         DateTime?

  // Billing / plan — controlled by the platform admin.
  // TRIAL with a trialEndsAt in the past blocks the workspace until upgraded.
  // A null trialEndsAt means no expiry has been set yet (open trial).
  plan          PlanTier  @default(TRIAL)
  trialEndsAt   DateTime?
  // Total upload storage allowed for the WHOLE organization, in MB.
  uploadLimitMb Int       @default(200)

  // v3: when false (the default), assigning a task sends it straight to the
  // assignee. When true, the Head of Design approves assignments first —
  // the v2 behaviour, now opt-in (docs/V3_CONTEXT.md §4).
  requireAssignmentApproval Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse relations — every tenant-scoped entity points back here
  users         User[]
  designations  DesignationRole[]
  clients       Client[]
  projects      Project[]
  tasks         Task[]
  invoices      Invoice[]
  contracts     Contract[]
  expenses      Expense[]
  receipts      Receipt[]
  files         File[]
  folders       Folder[]
  channels      Channel[]
  taskTemplates TaskTemplate[]
  statusHistory StatusHistory[]
  notifications Notification[]
  creativeTypes CreativeType[]
  contentItems  ContentItem[]
  events        CalendarEvent[]
  clientPackages ClientPackage[]
  followUps     FollowUp[]
  reviewBatches ReviewBatch[]

  @@map("organizations")
}

// ============================================================
// V2 — CLIENT REVIEW BATCHES (tokenized share links, no login)
// ============================================================

model ReviewBatch {
  id             String   @id @default(cuid())
  token          String   @unique
  organizationId String
  clientId       String
  month          String // YYYY-MM
  expiresAt      DateTime
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation("ClientReviewBatches", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedReviewBatches", fields: [createdById], references: [id])

  @@index([clientId])
  @@map("review_batches")
}

// ============================================================
// V2 — FOLLOW-UPS + JOB RUNS (notifications engine)
// ============================================================

enum FollowUpStatus {
  PENDING
  DONE
  SNOOZED
}

model FollowUp {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String
  assignedToId   String
  note           String
  dueAt          DateTime
  status         FollowUpStatus @default(PENDING)
  snoozedTo      DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation("ClientFollowUps", fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo   User         @relation("AssignedFollowUps", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedFollowUps", fields: [createdById], references: [id])

  @@index([organizationId, status, dueAt])
  @@index([clientId])
  @@map("follow_ups")
}

// Idempotency ledger for scheduled jobs — one row per job per calendar day
model JobRun {
  id      String   @id @default(cuid())
  jobName String
  runDate String // YYYY-MM-DD
  ranAt   DateTime @default(now())

  @@unique([jobName, runDate])
  @@map("job_runs")
}

// ============================================================
// V2 — CLIENT PACKAGES (monthly creative quotas)
// ============================================================

model ClientPackage {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  startMonth     DateTime // first day of the starting month
  endMonth       DateTime? // null = open-ended
  billingAmount  Decimal?  @db.Decimal(12, 2)
  currency       String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation("ClientPackages", fields: [clientId], references: [id], onDelete: Cascade)
  quotas       PackageQuota[]

  @@index([clientId, isActive])
  @@index([organizationId])
  @@map("client_packages")
}

model PackageQuota {
  id             String @id @default(cuid())
  packageId      String
  creativeTypeId String
  monthlyQty     Int

  package      ClientPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  creativeType CreativeType  @relation(fields: [creativeTypeId], references: [id], onDelete: Cascade)

  @@unique([packageId, creativeTypeId])
  @@map("package_quotas")
}

// ============================================================
// V2 — CALENDAR EVENTS (festivals, campaigns, shoots, internal)
// ============================================================

enum EventKind {
  FESTIVAL
  CAMPAIGN
  SHOOT
  INTERNAL
  OTHER
}

model CalendarEvent {
  id                 String    @id @default(cuid())
  organizationId     String
  title              String
  date               DateTime
  endDate            DateTime?
  kind               EventKind @default(OTHER)
  clientId           String?
  reminderDaysBefore Int?
  isAdHoc            Boolean   @default(false)
  notes              String?
  createdById        String?
  createdAt          DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation("ClientEvents", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedEvents", fields: [createdById], references: [id])

  @@index([organizationId, date])
  @@map("calendar_events")
}

// ============================================================
// V2 — MY CALENDAR (personal reminders / to-dos)
// ============================================================

// Google-Tasks-style personal lists on the /tasks board ("smokzy", "home"…)
model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user  User           @relation("TaskLists", fields: [userId], references: [id], onDelete: Cascade)
  items PersonalItem[]

  @@index([userId, sortOrder])
  @@map("task_lists")
}

model PersonalItem {
  id          String    @id @default(cuid())
  userId      String // whose calendar it sits on
  createdById String? // may differ — a senior dropping a to-do on a teammate
  listId      String? // board list; null = the default "My Tasks" column
  title       String
  note        String?
  date        DateTime
  time        String? // "17:00" — optional wall-clock time
  starred     Boolean   @default(false)
  done        Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation("PersonalItems", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedPersonalItems", fields: [createdById], references: [id])
  list      TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, listId])
  @@map("personal_items")
}

// ============================================================
// V2 — STATUS HISTORY (universal audit trail)
// ============================================================

model StatusHistory {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String // "TASK" | "PROJECT" | later: "CONTENT_ITEM", "BOOKING", "INVOICE", …
  entityId       String
  fromStatus     String?
  toStatus       String
  changedById    String?
  changedAt      DateTime @default(now())
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation("StatusChanges", fields: [changedById], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId])
  @@map("status_history")
}

// ============================================================
// V2 — NOTIFICATIONS (in-app notification center)
// ============================================================

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String // e.g. "TASK_ASSIGNED", "TASK_IN_REVIEW"
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
